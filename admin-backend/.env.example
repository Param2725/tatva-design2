# Admin credentials (single user, plain text)
ADMIN_USERNAME=usernameofchoice
ADMIN_PASSWORD=changeme

# JWT secrets (use long random strings in production)
JWT_SECRET=replace-with-64-char-random-string-for-access-tokens-here-now
JWT_REFRESH_SECRET=replace-with-64-char-random-string-for-refresh-tokens-here

# MongoDB connection
MONGODB_URI=mongodb://localhost:27017/tatva-analytics

# CORS — your frontend domain
ALLOWED_ORIGIN=https://tatvaconsultancy.in

# Server port
PORT=5000
